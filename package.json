{
  "name": "vsenv",
  "displayName": "VSenv",
  "version": "0.0.4",
  "description": "Extension that allows you to set environment variables that are visible to other extensions",
  "categories": [
    "Other"
  ],
  "repository": "https://github.com/detachhead/vsenv",
  "publisher": "detachhead",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "./pnpm.cmd run compile",
    "check": "./pnpm.cmd run check-types && ./pnpm.cmd run lint && ./pnpm.cmd run format:check",
    "compile": "./pnpm.cmd run check-types && node esbuild.mts",
    "package": "vsce package --no-dependencies --allow-star-activation",
    "check-types": "tsc",
    "lint": "oxlint .",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt"
  },
  "dependencies": {
    "@vscode/python-environments": ">=1.4.0",
    "@vscode/python-extension": ">=1.0.6"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": ">=4.8.1",
    "@stylistic/eslint-plugin": ">=5.10.0",
    "@types/node": "26.x",
    "@types/vscode": ">=1.143.0",
    "@vscode/vsce": ">=4.1.0",
    "esbuild": ">=0.28.1",
    "eslint": "^10.14.0",
    "eslint-plugin-prefer-arrow-functions": ">=3.10.2",
    "ovsx": ">=1.3.0",
    "oxfmt": ">=0.75.0",
    "oxlint": ">=1.90.0",
    "oxlint-tsgolint": ">=7.0.2005",
    "typescript": "^6"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "vsenv",
      "properties": {
        "vsenv.paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "activationEvents": [
    "*"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.3.1",
      "onFail": "download"
    }
  },
  "engines": {
    "vscode": ">=1.143.0"
  }
}
